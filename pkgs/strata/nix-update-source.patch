+#[test]
+fn nix_updates_show_localized_guidance_and_never_start_an_install() {
+    gtk_test(
+        "ui::settings::tests::updates::nix_updates_show_localized_guidance_and_never_start_an_install",
+        || {
+            let manager = PreferenceManager::shared();
+            manager.set_checks_for_updates(true);
+            let automatic = automatic_updates_option(&manager, UpdateMethod::Nix);
+            let toggle = automatic
+                .last_child()
+                .unwrap()
+                .downcast::<gtk::Switch>()
+                .unwrap();
+            assert!(!toggle.is_active());
+            assert!(!toggle.is_sensitive());
+            assert!(
+                manager.checks_for_updates(),
+                "opening settings preserves the preference"
+            );
+            assert!(page_text(automatic.upcast_ref()).contains("Update Strata through Nix."));
+
+            let installer = FakeInstaller::default();
+            let row = update_check_row_with(
+                manager,
+                release_notes_card(ReleaseNotesKind::Available, "Available release", ""),
+                install_guard(),
+                UpdateMethod::Nix,
+                installer.launcher(),
+            );
+            let button = &row.responsive_action.1;
+            assert!(!button.is_sensitive());
+            assert_eq!(
+                button.tooltip_text().as_deref(),
+                Some("Update Strata through Nix.")
+            );
+            assert!(row.status.text().contains("Managed by Nix"));
+            (row.run_check)(true);
+            assert!(row.status.text().contains("Managed by Nix"));
+            seed_offer(&row);
+            button.emit_clicked();
+            assert!(installer.requests().is_empty());
+            for (locale, expected) in [
+                ("en", "Update Strata through Nix."),
+                ("zh-CN", "可通过 Nix 更新 Strata。"),
+                ("de", "Aktualisieren Sie Strata über Nix."),
+            ] {
+                rust_i18n::set_locale(locale);
+                assert_eq!(nix_update_instruction(), expected);
+            }
+        },
+    );
+}
